{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://walle.dev/schemas/navbar.schema.json",
  "title": "Walle navbar config (src/configs/navbar.json)",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "logo": {
      "type": "object",
      "properties": {
        "src": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        },
        "alt": {
          "type": "string"
        },
        "cssClasses": {
          "type": "string"
        },
        "license": {
          "type": "string"
        }
      },
      "required": ["url"],
      "additionalProperties": false
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "icon": {
            "type": "string"
          },
          "target": {
            "type": "string",
            "enum": ["_blank", "_self"]
          },
          "dropdown": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                },
                "icon": {
                  "type": "string"
                },
                "target": {
                  "type": "string",
                  "enum": ["_blank", "_self"]
                }
              },
              "required": ["url"],
              "additionalProperties": false
            }
          }
        },
        "required": ["url"],
        "additionalProperties": false
      }
    }
  },
  "required": ["logo", "items"],
  "additionalProperties": false
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://walle.dev/schemas/theme.schema.json",
  "title": "Walle theme tokens (src/configs/theme.json)",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "palette": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "typography": {
      "type": "object",
      "properties": {
        "fontFamilyBase": {
          "type": "string"
        },
        "fontFamilyHeading": {
          "type": "string"
        },
        "fontFamilyMono": {
          "type": "string"
        },
        "scale": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "fonts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": {
                "type": "string",
                "enum": ["body", "heading", "mono"]
              },
              "name": {
                "type": "string"
              },
              "provider": {
                "type": "string",
                "enum": ["local", "google", "fontsource"]
              },
              "weights": {
                "type": "array",
                "items": {
                  "type": ["string", "number"]
                }
              },
              "styles": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": ["normal", "italic", "oblique"]
                }
              },
              "src": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "preload": {
                "type": "boolean"
              },
              "fallback": {
                "type": "string",
                "enum": ["serif", "sans-serif", "monospace", "system-ui"]
              },
              "display": {
                "type": "string",
                "enum": ["auto", "block", "fallback", "optional", "swap"]
              }
            },
            "required": ["role", "name", "provider"],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "spacing": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "radii": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "neutral": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "shadow": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}

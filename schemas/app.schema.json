{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://walle.dev/schemas/app.schema.json",
  "title": "Walle app config (src/configs/app.json)",
  "version": "2.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["website", "astro"],
  "properties": {
    "$schema": { "type": "string" },
    "website": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description"],
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "favicon": { "type": "string" },
        "image": { "type": "string" },
        "robots": { "type": "string" },
        "language": { "type": "string" }
      }
    },
    "astro": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseUrl", "basePath"],
      "properties": {
        "baseUrl": { "type": "string" },
        "basePath": { "type": "string" },
        "trailingSlash": { "enum": ["always", "never", "ignore"] },
        "analyticsScriptContent": { "type": "string" },
        "ssr": {
          "type": "object",
          "additionalProperties": false,
          "description": "Optional SSR config. Absent or enabled:false => static output (default).",
          "properties": {
            "enabled": { "type": "boolean", "default": false },
            "adapter": { "enum": ["node"], "default": "node" }
          }
        }
      }
    },
    "components": {
      "type": "object",
      "description": "Per-component variant selection. Absent key => 'standard'.",
      "additionalProperties": { "type": "string" },
      "properties": {
        "navbar": { "type": "string", "default": "standard" },
        "footer": { "type": "string", "default": "standard" }
      }
    },
    "pwa": {
      "type": "object",
      "additionalProperties": false,
      "description": "Progressive web app. Opt-in: absent or enabled:false => no manifest, no service worker, no registration script. Every other key falls back to the site's website/theme config.",
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "name": { "type": "string", "description": "Defaults to website.title." },
        "shortName": { "type": "string", "description": "Home-screen label. Defaults to name." },
        "description": { "type": "string", "description": "Defaults to website.description." },
        "lang": { "type": "string", "description": "Defaults to website.language." },
        "themeColor": {
          "type": "string",
          "description": "Browser chrome color. Defaults to the theme palette's primary."
        },
        "backgroundColor": {
          "type": "string",
          "description": "Splash background. Defaults to the theme palette's background."
        },
        "display": {
          "enum": ["standalone", "fullscreen", "minimal-ui", "browser"],
          "default": "standalone"
        },
        "startUrl": { "type": "string", "description": "Defaults to astro.basePath." },
        "scope": { "type": "string", "description": "Defaults to astro.basePath." },
        "icons": {
          "type": "array",
          "description": "Manifest icons, served from public/. Without these a browser shows no install prompt.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["src", "sizes"],
            "properties": {
              "src": { "type": "string" },
              "sizes": { "type": "string" },
              "type": { "type": "string" },
              "purpose": { "type": "string" }
            }
          }
        },
        "appleTouchIcon": {
          "type": "string",
          "description": "iOS home-screen icon. Omitted => no apple-touch-icon link."
        }
      }
    },
    "commerce": {
      "type": "object",
      "additionalProperties": false,
      "description": "Shopify headless catalog. showBuyButton:false => vetrina (catalog only, no cart/checkout).",
      "properties": {
        "showBuyButton": { "type": "boolean", "default": false },
        "cartInNavbar": {
          "type": "boolean",
          "default": false,
          "description": "true => cart trigger lives in the navbar; false => floating badge."
        },
        "locale": { "type": "string", "default": "en-US" },
        "addToCartLabel": {
          "type": "string",
          "default": "Add to cart",
          "description": "Text on the add-to-cart button (icon is always shown alongside it)."
        },
        "showAddToCartOnCards": {
          "type": "boolean",
          "default": true,
          "description": "Show the add-to-cart button on product listing cards. false => cards link to the detail page only (add-to-cart still available there). No effect in vetrina mode."
        }
      }
    }
  }
}

---
import { Icon } from "astro-icon/components";
import type { BaseProps, Size, Variant } from "../shared/types";
import { linkAttrs, splitProps, variantAttrs } from "../shared/attrs";

export interface Props extends BaseProps {
  /**
   * Text to display in the button
   */
  text: string;

  /**
   * Destination URL: when set, the component renders an `<a>` styled as a button
   */
  href?: string;

  /**
   * Link target (only used with `href`)
   */
  target?: "_blank" | "_self";

  /**
   * Visual variant
   * @default "primary"
   */
  variant?: Variant;

  /**
   * Transparent background with a variant-colored border and text
   * @default false
   */
  outline?: boolean;

  /**
   * Colors suited for a dark or filled background. Combines with `outline`
   * (used together on the hero's own colored background).
   * @default false
   */
  inverse?: boolean;

  /**
   * Icon name to display (astro-icon)
   */
  icon?: string;

  /**
   * Button size
   * @default "medium"
   */
  size?: Size;

  /**
   * If true, button takes full available width
   * @default false
   */
  fullWidth?: boolean;

  /**
   * If true, disable the button
   * @default false
   */
  disabled?: boolean;

  /**
   * Native button type (ignored when `href` is set)
   * @default "button"
   */
  type?: "button" | "submit" | "reset";
}

const OWN_KEYS = [
  "text",
  "href",
  "target",
  "variant",
  "outline",
  "inverse",
  "icon",
  "size",
  "fullWidth",
  "disabled",
  "type",
  "class",
] as const;

const { own, rest } = splitProps(Astro.props, OWN_KEYS);
const {
  text,
  href,
  target,
  variant = "primary",
  outline = false,
  inverse = false,
  icon,
  size = "medium",
  fullWidth = false,
  disabled = false,
  type = "button",
  class: className,
} = own;

const buttonClasses = ["button", fullWidth ? "button-full-width" : "", className ?? ""]
  .filter(Boolean)
  .join(" ");

const isLink = Boolean(href) && !disabled;
const Tag = isLink ? "a" : "button";

const tagAttrs = isLink
  ? { href, target, rel: linkAttrs({ target }).rel }
  : { type, disabled, "aria-disabled": disabled ? ("true" as const) : undefined };
---

<Tag
  class={buttonClasses}
  {...tagAttrs}
  {...variantAttrs({ variant, outline, inverse })}
  data-component="Button"
  data-size={size}
  {...rest}
>
  <span class="button-text">{text}</span>
  {icon && <Icon name={icon} class="button-icon" />}
</Tag>

<style>
  @layer walle.components {
    .button {
      /* Public properties */
      --button-bg: var(--variant-bg);
      --button-bg-hover: color-mix(in srgb, var(--button-bg), var(--black) 30%);
      --button-fg: var(--variant-fg);
      --button-border: var(--button-bg);
      --button-radius: var(--radius-xl);
      --button-padding-x: var(--space-2xl);
      --button-padding-y: var(--space-md);
      --button-shadow: var(--shadow-md);
      --button-font-weight: 600;

      /* Structure */
      position: relative;
      overflow: hidden;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      box-sizing: border-box;
      font-family: inherit;
      font-weight: var(--button-font-weight);
      text-decoration: none;
      white-space: nowrap;
      letter-spacing: 0.025em;
      cursor: pointer;
      border-radius: var(--button-radius);
      border: 2px solid var(--button-border);
      padding: var(--button-padding-y) var(--button-padding-x);
      background: var(--button-bg);
      color: var(--button-fg);
      box-shadow: var(--button-shadow);
      transition: var(--transition-normal);
    }

    .button:hover:not(:disabled) {
      background: var(--button-bg-hover);
      border-color: var(--button-bg-hover);
      transform: translateY(-1px);
    }

    .button:active:not(:disabled) {
      transform: translateY(0);
    }

    /* Modifiers map --variant-* tokens to the public properties above; a higher-specificity
           [data-inverse][data-outline] rule handles the combined case (a button on a filled,
           colored background that is also outlined). */
    .button[data-outline] {
      --button-bg: transparent;
      --button-bg-hover: var(--variant-bg-hover);
      --button-fg: var(--variant-color);
      --button-border: var(--variant-color);
      --button-shadow: none;
    }

    .button[data-outline]:hover:not(:disabled) {
      color: var(--variant-fg);
    }

    .button[data-inverse] {
      --button-bg: var(--surface);
      --button-bg-hover: color-mix(in srgb, var(--button-bg), var(--variant-color) 12%);
      --button-fg: var(--variant-color);
      --button-border: var(--variant-color);
    }

    .button[data-inverse]:hover:not(:disabled) {
      color: var(--variant-color-hover);
      border-color: var(--variant-color-hover);
    }

    .button[data-inverse][data-outline] {
      --button-bg: transparent;
      --button-bg-hover: var(--surface);
      --button-fg: var(--variant-fg);
      --button-border: var(--variant-fg);
      --button-shadow: none;
    }

    .button[data-inverse][data-outline]:hover:not(:disabled) {
      color: var(--variant-color);
      border-color: var(--surface);
    }

    /* Sizes */
    .button[data-size="small"] {
      --button-padding-x: var(--space-lg);
      --button-padding-y: var(--space-sm);
      --button-radius: var(--radius-md);
      font-size: 0.875rem;
    }

    .button[data-size="medium"] {
      font-size: 1rem;
    }

    .button[data-size="large"] {
      --button-padding-x: var(--space-3xl);
      --button-padding-y: var(--space-lg);
      font-size: 1.125rem;
    }

    .button-full-width {
      width: 100%;
    }

    .button-text {
      display: inline-block;
    }

    .button-icon {
      display: inline-block;
      margin-left: 0.5rem;
      vertical-align: -0.15em;
      width: 1em;
      height: 1em;
    }

    .button:disabled {
      opacity: var(--disabled-opacity);
      cursor: not-allowed;
      pointer-events: none;
      box-shadow: none;
    }

    @media (max-width: 768px) {
      .button[data-size="small"] {
        font-size: 0.75rem;
        --button-padding-x: var(--space-md);
        --button-padding-y: var(--space-xs);
      }

      .button[data-size="medium"] {
        font-size: 0.875rem;
        --button-padding-x: var(--space-lg);
        --button-padding-y: var(--space-sm);
      }

      .button[data-size="large"] {
        font-size: 1rem;
        --button-padding-x: var(--space-xl);
        --button-padding-y: var(--space-md);
      }
    }
  }
</style>

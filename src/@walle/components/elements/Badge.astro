---
import { Icon } from "astro-icon/components";
import type { BaseProps, Size, Variant } from "../shared/types";
import { linkAttrs, splitProps, variantAttrs } from "../shared/attrs";

export interface Props extends BaseProps {
  /**
   * Text to display in the badge
   */
  text: string;

  /**
   * Visual variant
   * @default "primary"
   */
  variant?: Variant;

  /**
   * Transparent background with a variant-colored border and text
   * @default false
   */
  outline?: boolean;

  /**
   * Neutral surface background regardless of variant
   * @default false
   */
  muted?: boolean;

  /**
   * Semantic status coloring: takes precedence over `variant` when set
   */
  status?: "success" | "warning" | "danger";

  /**
   * Icon name to show (astro-icon)
   */
  icon?: string;

  /**
   * Icon position relative to text
   * @default "end"
   */
  iconPosition?: "start" | "end";

  /**
   * Destination URL: when set, the badge renders as a link
   */
  href?: string;

  /**
   * Link target (only used with `href`)
   */
  target?: "_blank" | "_self";

  /**
   * Badge size
   * @default "medium"
   */
  size?: Size;
}

const OWN_KEYS = [
  "text",
  "variant",
  "outline",
  "muted",
  "status",
  "icon",
  "iconPosition",
  "href",
  "target",
  "size",
  "class",
] as const;

const { own, rest } = splitProps(Astro.props, OWN_KEYS);
const {
  text,
  variant = "primary",
  outline = false,
  muted = false,
  status,
  icon,
  iconPosition = "end",
  href,
  target,
  size = "medium",
  class: className,
} = own;

const badgeClasses = [
  "badge",
  icon ? `badge-with-icon badge-icon-${iconPosition}` : "",
  className ?? "",
]
  .filter(Boolean)
  .join(" ");

const Element = href ? "a" : "span";

const hrefAttrs = href ? { href, target, rel: linkAttrs({ target }).rel } : {};
---

<Element
  class={badgeClasses}
  {...hrefAttrs}
  {...variantAttrs({ variant, outline, muted })}
  data-component="Badge"
  data-size={size}
  data-status={status}
  {...rest}
>
  {icon && <Icon name={icon} class="badge-icon" aria-hidden="true" />}
  <span class="badge-text">{text}</span>
</Element>

<style>
  @layer walle.components {
    .badge {
      /* Public properties */
      --badge-bg: var(--variant-bg);
      --badge-fg: var(--variant-fg);
      --badge-border: var(--badge-bg);
      --badge-radius: var(--radius-sm);
      --badge-padding: 0.25em 0.8em;

      /* Structure */
      display: inline-flex;
      align-items: center;
      gap: 0.4em;
      font-weight: 500;
      text-decoration: none;
      border-radius: var(--badge-radius);
      border: 1px solid var(--badge-border);
      padding: var(--badge-padding);
      background: var(--badge-bg);
      color: var(--badge-fg);
      transition: var(--transition);
    }

    .badge-with-icon {
      position: relative;
    }

    .badge-icon-start {
      flex-direction: row;
    }

    .badge-icon-end {
      flex-direction: row-reverse;
    }

    .badge-icon {
      width: 1em;
      height: 1em;
      display: inline-block;
    }

    /* outline/muted map variant tokens to the public properties; status overrides both,
           using its own tokens rather than the palette. */
    .badge[data-outline] {
      --badge-bg: transparent;
      --badge-fg: var(--variant-color);
      --badge-border: var(--variant-color);
    }

    .badge[data-muted] {
      --badge-bg: var(--surface-alt);
      --badge-fg: var(--text);
      --badge-border: var(--surface-alt);
    }

    .badge[data-status="success"] {
      --badge-bg: var(--status-success);
      --badge-fg: var(--status-success-contrast);
      --badge-border: var(--status-success);
    }

    .badge[data-status="warning"] {
      --badge-bg: var(--status-warning);
      --badge-fg: var(--status-warning-contrast);
      --badge-border: var(--status-warning);
    }

    .badge[data-status="danger"] {
      --badge-bg: var(--status-danger);
      --badge-fg: var(--status-danger-contrast);
      --badge-border: var(--status-danger);
    }

    .badge[data-status][data-outline] {
      --badge-bg: transparent;
      --badge-fg: var(--badge-border);
    }

    /* Link behavior */
    a.badge {
      cursor: pointer;
    }

    a.badge:hover {
      transform: translateY(-1px);
      box-shadow: var(--shadow-sm);
    }

    .badge + .badge {
      margin-left: 0.5rem;
    }

    @media (max-width: 768px) {
      .badge[data-size="large"] {
        font-size: 0.95rem;
        --badge-padding: 0.25em 0.8em;
      }
    }

    .badge[data-size="small"] {
      font-size: 0.8rem;
      --badge-padding: 0.2em 0.7em;
    }

    .badge[data-size="medium"] {
      font-size: 0.95rem;
    }

    .badge[data-size="large"] {
      font-size: 1rem;
      --badge-padding: 0.3em 0.9em;
    }
  }
</style>

---
import type { BaseProps, Size } from "../shared/types";
import { splitProps } from "../shared/attrs";
import { label as t, locale as siteLocale } from "@walle/utils";

export interface PriceData {
  /**
   * Current price amount
   */
  amount: number;

  /**
   * ISO 4217 currency code (e.g. "EUR", "USD")
   */
  currency: string;

  /**
   * Original price before discount: rendered struck-through
   */
  compareAt?: number;
}

export interface Props extends BaseProps {
  /**
   * Price to display
   */
  price: PriceData;

  /**
   * BCP 47 locale for formatting
   * @default site language from config
   */
  locale?: string;

  /**
   * Size
   * @default "medium"
   */
  size?: Size;

  /**
   * Accessible label announced for the discounted (current) price
   * @default "Discounted price"
   */
  discountedLabel?: string;

  /**
   * Accessible label announced for the original (struck-through) price
   * @default "Original price"
   */
  originalLabel?: string;
}

const OWN_KEYS = ["price", "locale", "size", "discountedLabel", "originalLabel", "class"] as const;

const { own, rest } = splitProps(Astro.props, OWN_KEYS);
const {
  price,
  locale = siteLocale(),
  size = "medium",
  discountedLabel: discountedLabelProp,
  originalLabel: originalLabelProp,
  class: className,
} = own;

const discountedLabel = t("price.discounted", discountedLabelProp);
const originalLabel = t("price.original", originalLabelProp);

// Intl wants BCP 47 (hyphens); tolerate a POSIX-style "it_IT" so a config typo
// can't throw a RangeError at build.
const bcp47 = locale.replace(/_/g, "-");
const format = (amount: number) =>
  new Intl.NumberFormat(bcp47, { style: "currency", currency: price.currency }).format(amount);

const hasDiscount = price.compareAt != null && price.compareAt > price.amount;
const classes = ["price", className ?? ""].filter(Boolean).join(" ");
---

<span class={classes} data-component="Price" data-size={size} {...rest}>
  {
    hasDiscount && (
      <s class="price-compare">
        <span class="sr-only">{originalLabel}: </span>
        {format(price.compareAt!)}
      </s>
    )
  }
  <span class="price-current">
    {hasDiscount && <span class="sr-only">{discountedLabel}: </span>}
    {format(price.amount)}
  </span>
</span>

<style>
  @layer walle.components {
    .price {
      /* Public properties */
      --price-color: var(--text);
      --price-compare-color: var(--text-muted);

      display: inline-flex;
      align-items: baseline;
      gap: 0.5em;
      font-weight: 700;
      color: var(--price-color);
    }

    .price[data-size="small"] {
      font-size: 0.875rem;
    }

    .price[data-size="medium"] {
      font-size: 1.125rem;
    }

    .price[data-size="large"] {
      font-size: 1.5rem;
    }

    .price-compare {
      font-weight: 400;
      font-size: 0.85em;
      color: var(--price-compare-color);
    }
  }
</style>

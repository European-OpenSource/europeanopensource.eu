---
import { Icon } from "astro-icon/components";
import type { BaseProps, Variant } from "../shared/types";
import { linkAttrs, splitProps } from "../shared/attrs";

export interface Props extends BaseProps {
  /**
   * Destination URL
   */
  href: string;

  /**
   * Link target. Defaults to `_blank` for external links, `_self` otherwise.
   */
  target?: "_blank" | "_self";

  /**
   * Visual variant
   * @default "primary"
   */
  variant?: Variant;

  /**
   * Muted color, for de-emphasized links
   * @default false
   */
  muted?: boolean;

  /**
   * No color/decoration of its own: inherits from the surrounding text
   * @default false
   */
  unstyled?: boolean;

  /**
   * Show the external-link icon on external links
   * @default true
   */
  externalIcon?: boolean;

  /**
   * Link text: used when no slot content is provided
   */
  text?: string;
}

const OWN_KEYS = [
  "href",
  "target",
  "variant",
  "muted",
  "unstyled",
  "externalIcon",
  "text",
  "class",
] as const;

const { own, rest } = splitProps(Astro.props, OWN_KEYS);
const {
  href,
  target,
  // No default: data-variant is emitted only when a caller passes variant.
  variant,
  muted = false,
  unstyled = false,
  externalIcon = true,
  text,
  class: className,
} = own;

// External = absolute URL pointing at a different host than the site.
const site = Astro.site?.host;
let isExternal = false;
try {
  isExternal =
    new URL(href, Astro.site ?? "http://localhost").host !== site && /^[a-z]+:\/\//i.test(href);
} catch {
  isExternal = false;
}

const { target: resolvedTarget, rel } = linkAttrs({ target, external: isExternal });

const classes = ["link", className ?? ""].filter(Boolean).join(" ");
---

<a
  href={href}
  target={resolvedTarget}
  rel={rel}
  class={classes}
  data-variant={variant}
  data-muted={muted ? "true" : undefined}
  data-unstyled={unstyled ? "true" : undefined}
  data-component="Link"
  {...rest}
>
  <slot>{text}</slot>{
    isExternal && externalIcon && (
      <Icon name="mdi:open-in-new" class="link-external-icon" aria-hidden="true" />
    )
  }
</a>

<style>
  @layer walle.components {
    .link {
      /* Public properties. [data-variant] below overrides these to that variant's own pair. */
      --link-color: var(--link);
      --link-color-hover: var(--link-hover);
      --link-decoration: underline;

      color: var(--link-color);
      text-decoration: var(--link-decoration);
      text-underline-offset: 0.15em;
    }

    .link:hover {
      color: var(--link-color-hover);
    }

    .link[data-variant] {
      --link-color: var(--variant-color);
      --link-color-hover: var(--variant-color-hover);
    }

    .link[data-muted] {
      --link-color: var(--text-muted);
      --link-color-hover: var(--text);
    }

    .link[data-unstyled] {
      --link-decoration: none;
      color: inherit;
      font-weight: inherit;
    }

    .link[data-unstyled]:hover {
      color: inherit;
    }

    .link-external-icon {
      width: 0.85em;
      height: 0.85em;
      margin-left: 0.2em;
      vertical-align: -0.08em;
    }
  }
</style>

---
import { Icon } from "astro-icon/components";
import type { BaseProps } from "../shared/types";
import { splitProps } from "../shared/attrs";
import { label } from "@walle/utils";

export interface BreadcrumbItem {
  /**
   * Label to display
   */
  label: string;

  /**
   * Destination URL
   */
  href?: string;

  /**
   * Icon name (optional)
   */
  icon?: string;
}

export interface Props extends BaseProps<"nav"> {
  /**
   * Array of breadcrumb items
   */
  items: BreadcrumbItem[];

  /**
   * Custom separator (default: chevron-right)
   */
  separator?: string;
}

const OWN_KEYS = ["items", "separator", "class"] as const;
const { own, rest } = splitProps(Astro.props, OWN_KEYS);
const { items = [], class: className } = own;
---

<nav aria-label={label("breadcrumbs.nav")} class:list={["breadcrumbs", className]} {...rest}>
  <ol>
    {
      items.map((item, index) => (
        <li class={index === items.length - 1 ? "current" : ""}>
          {index > 0 && (
            <span class="separator" aria-hidden="true">
              {" "}
              /{" "}
            </span>
          )}

          {item.href && index !== items.length - 1 ? (
            <a href={item.href}>
              {item.icon && <Icon name={item.icon} class="item-icon" aria-hidden="true" />}
              <span>{item.label}</span>
            </a>
          ) : (
            <span
              class="current-item"
              aria-current={index === items.length - 1 ? "page" : undefined}
            >
              {item.icon && <Icon name={item.icon} class="item-icon" aria-hidden="true" />}
              <span>{item.label}</span>
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  @layer walle.components {
    .breadcrumbs {
      /* Public properties */
      --breadcrumbs-color: var(--primary);
      --breadcrumbs-current-color: var(--text-muted);
      --breadcrumbs-separator-color: color-mix(in srgb, var(--text-muted) 60%, transparent);

      margin-bottom: 1.5rem;
      font-size: 0.95rem;
      color: var(--text-muted);
    }

    .breadcrumbs ol {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      list-style: none;
      padding: 0;
      margin: 0;
      gap: 0.2rem;
    }

    .breadcrumbs li {
      display: flex;
      align-items: center;
    }

    .breadcrumbs a {
      color: var(--breadcrumbs-color);
      text-decoration: none;
      display: flex;
      align-items: center;
      gap: 0.3rem;
      padding: 0.3rem 0.4rem;
      border-radius: var(--radius-md);
      transition: all 0.15s ease;
      white-space: nowrap;
    }

    .breadcrumbs a:hover {
      background: color-mix(in srgb, var(--primary) 5%, transparent);
      color: var(--primary-dark);
    }

    .current-item {
      color: var(--breadcrumbs-current-color);
      display: flex;
      align-items: center;
      gap: 0.3rem;
      padding: 0.3rem 0.4rem;
      white-space: nowrap;
      min-width: 0;
    }

    /* Safety net, not a visual change: an over-long label is clipped here instead of pushing
           the page wider than the viewport. `min-width: 0` on both the <li> and the flex parent
           is required for the text to shrink at all: flex items default to min-width: auto and
           refuse to go below their content width, so overflow/text-overflow alone would do
           nothing without it. */
    .breadcrumbs li {
      min-width: 0;
    }

    .current-item > span {
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .separator {
      color: var(--breadcrumbs-separator-color);
      display: flex;
      align-items: center;
      font-size: 0.7rem;
      margin: 0 0.2rem;
    }

    .item-icon {
      width: 0.9em;
      height: 0.9em;
    }

    @media (max-width: 640px) {
      .breadcrumbs {
        font-size: 0.85rem;
      }

      /* Hide Home (first item) on mobile, show immediate parent + current */
      .breadcrumbs li:first-child {
        display: none;
      }

      /* Hide the leading separator on the item that becomes first visible */
      .breadcrumbs li:first-child + li .separator {
        display: none;
      }

      /* Drop the current page too, same reasoning that already drops Home: it duplicates the
                 page's own <h1>. `:not(:nth-child(2))` guards a two-item trail (Home / Current): with
                 Home already hidden, the second child is the first crumb still visible, so hiding
                 the current one too would leave an empty nav. */
      .breadcrumbs li.current:not(:nth-child(2)) {
        display: none;
      }
    }

    @media (max-width: 380px) {
      .breadcrumbs a,
      .current-item {
        padding: 0.2rem;
      }
    }
  }
</style>

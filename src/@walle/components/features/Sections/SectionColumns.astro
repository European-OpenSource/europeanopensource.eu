---
import type { BaseProps, VariantProps, ModifierProps } from "../../shared/types";
import { splitProps } from "../../shared/attrs";
import SectionWrapper from "./SectionWrapper.astro";

export interface Props
  extends BaseProps<"section">, VariantProps, Pick<ModifierProps, "filled" | "muted"> {
  /** Section title (optional) */
  title?: string;

  /**
   * Number of columns on wide screens; collapses to 1 on narrow viewports
   * via CSS only
   * @default 3
   */
  columns?: 2 | 3 | 4;

  /**
   * Minimum column width before wrapping (CSS length)
   * @default "16rem"
   */
  minColumnWidth?: string;

  /**
   * Center the title
   * @default false
   */
  centered?: boolean;
}

const OWN_KEYS = [
  "title",
  "columns",
  "minColumnWidth",
  "centered",
  "variant",
  "filled",
  "muted",
] as const;

const { own, rest } = splitProps(Astro.props, OWN_KEYS);
const {
  title,
  columns = 3,
  minColumnWidth = "16rem",
  centered = false,
  variant,
  filled = false,
  muted = false,
} = own;
---

<SectionWrapper
  title={title}
  centered={centered}
  variant={variant}
  filled={filled}
  muted={muted}
  data-component="SectionColumns"
  data-columns={columns}
  {...rest}
>
  <slot name="title" slot="title" />
  <div class="section-columns__grid" style={`--columns: ${columns}; --min-col: ${minColumnWidth};`}>
    <slot />
  </div>
</SectionWrapper>

<style>
  @layer walle.components {
    /* auto-fit + minmax: columns collapse to 1 on narrow viewports without JS
           or breakpoint props; --columns caps the count on wide screens. */
    .section-columns__grid {
      /* Public properties */
      --section-columns-gap: var(--space-xl);

      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--min-col)), 1fr));
      gap: var(--section-columns-gap);
    }

    @media (min-width: 769px) {
      .section-columns__grid {
        grid-template-columns: repeat(var(--columns), minmax(0, 1fr));
      }
    }
  }
</style>

---
import { Image } from "astro:assets";
import type { BaseProps, VariantProps, ModifierProps } from "../../shared/types";
import { splitProps } from "../../shared/attrs";
import SectionWrapper from "./SectionWrapper.astro";

export interface Props
  extends BaseProps<"section">, VariantProps, Pick<ModifierProps, "filled" | "muted"> {
  title: string;
  image?: {
    src: ImageMetadata | string;
    alt: string;
  };
  reversed?: boolean;
  centered?: boolean;
}

const OWN_KEYS = ["title", "image", "reversed", "centered", "variant", "filled", "muted"] as const;

const { own, rest } = splitProps(Astro.props, OWN_KEYS);
const {
  title,
  image = null,
  centered = false,
  variant,
  filled = false,
  muted = false,
  reversed = false,
} = own;
---

<SectionWrapper centered={centered} variant={variant} filled={filled} muted={muted} {...rest}>
  <div class:list={["section-content", { "section-content-image": image, reversed }]}>
    <div class="text-container">
      <h2 class="section-title">{Astro.slots.has("title") ? <slot name="title" /> : title}</h2>
      <slot />
    </div>
    {
      image && (
        <div class="image-container">
          {/* image.src is `string | ImageMetadata`; Astro's <Image> only overloads on one or
               the other, so a union value never resolves to either branch on its own. */}
          <Image
            src={image.src as string}
            alt={image.alt}
            width={500}
            height={400}
            loading="lazy"
            class="section-image"
          />
        </div>
      )
    }
  </div>
</SectionWrapper>

<style>
  @layer walle.components {
    .section-content-image {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-4xl);
      align-items: center;
    }

    .reversed {
      direction: rtl;
    }

    .text-container {
      direction: ltr;
    }

    .section-title {
      margin: 0 0 var(--space-2xl);
      color: var(--wrapper-title-color);
      font-size: clamp(2rem, 4vw, 2.75rem);
      font-weight: 700;
      line-height: 1.2;
    }

    .image-container {
      direction: ltr;
      border-radius: var(--radius-xl);
      overflow: hidden;
      box-shadow: var(--shadow-md);
      background-color: var(--surface);
      padding: var(--space-2xl);
      display: flex;
      justify-content: center;
      align-items: center;
      transition: var(--transition-normal);
    }

    .image-container:hover {
      transform: translateY(-6px);
      box-shadow: var(--shadow-lg);
    }

    .section-image {
      max-width: 100%;
      height: auto;
      border-radius: var(--radius-md);
    }

    @media (max-width: 900px) {
      .section-content-image {
        grid-template-columns: 1fr;
        gap: var(--space-2xl);
      }

      .image-container {
        order: -1;
      }

      .reversed {
        direction: ltr;
      }
    }
  }
</style>

---
import type { HTMLAttributes } from "astro/types";
import { normalizePath, resolveInternalUrl } from "@walle/utils";

interface Props extends HTMLAttributes<"a"> {
  /** Visible link text, when the caller renders one. Icon-only links (no visible text) still
   * get the "Go to X" fallback below, since their accessible name would otherwise be empty. */
  name?: string;
}

const { href, name, class: className, "aria-label": ariaLabel, ...props } = Astro.props;
const resolvedHref = resolveInternalUrl(String(href || ""));
const currentPath = normalizePath(Astro.url.pathname);
const targetPath = normalizePath(resolvedHref);
const isInternal = targetPath.startsWith("/");
const isHome = isInternal && targetPath === normalizePath(import.meta.env.BASE_URL || "/");
const isActive =
  isInternal &&
  (isHome
    ? currentPath === targetPath
    : currentPath === targetPath || currentPath.startsWith(`${targetPath}/`));
---

<a
  href={resolvedHref}
  class:list={[className, { active: isActive }]}
  {...props}
  aria-label={ariaLabel ?? (name ? undefined : `Go to ${resolvedHref}`)}
>
  <slot />
</a>

---
import config from "@walle/config";
import { resolveInternalUrl, truncateAtWord } from "@walle/utils";
import pwa from "virtual:walle-pwa";
import "@walle/styles/global.css";

interface Props {
  title: string;
  description: string;
  image?: string;
  ogImage?: string;
  robots?: string;
  favicon?: string;
  /**
   * Article publication timestamp — emits `article:published_time`
   */
  publishedTime?: Date | string | null;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {
  title,
  description = config.app.website.description,
  image = config.app.website.image,
  ogImage,
  robots = null,
  favicon = config.app.website.favicon,
  publishedTime = null,
} = Astro.props;

// Site-name suffix, dropped rather than truncated when it would push the title past the
// configured budget. Opt-in per site via `website.titleMaxLength`: without that key the suffix
// is always appended, so every other walle consumer keeps its current titles byte for byte.
//
// Why drop the suffix instead of shortening the title: the page's own title is the content, the
// site name is boilerplate repeated on every page. On a site whose titles are event names
// (eventialatina.it), 10 of the 14 over-budget titles were over budget *only* because of the
// 18-character suffix — the event name itself already fit. Truncating a real event name to fit
// a fixed brand suffix would be trading the useful half for the redundant one.
//
// Google truncates the SERP display around 60 characters but still ranks on the full title, so
// this is a click-through concern, not a ranking one: a title that is long because the page's
// own name is long stays as it is (no ellipsis, no cut), it just loses the suffix first.
const titleMaxLength = config.app.website.titleMaxLength as number | undefined;
const titleWithSuffix = title + " | " + config.app.website.title;
const titleSeo =
  titleMaxLength && titleWithSuffix.length > titleMaxLength ? title : titleWithSuffix;

// Same opt-in shape as titleMaxLength (absent key = unchanged behaviour for other consumers),
// but the opposite treatment, because a description is prose and a title is a name: here there
// is no boilerplate half to drop, so an over-budget description is cut at the last word boundary
// that fits and gets an ellipsis. Google truncates it anyway past ~155 characters; cutting on a
// word ourselves just means it ends on a word instead of mid-syllable, and the full text is on
// the page regardless. Note the budget is measured in UTF-16 code units, so an emoji (common at
// the start of these event blurbs) counts as two — deliberately conservative.
const descriptionMaxLength = config.app.website.descriptionMaxLength as number | undefined;
const descriptionSeo = descriptionMaxLength
  ? truncateAtWord(description, descriptionMaxLength)
  : description;

const ogImageUrl = ogImage ?? new URL(image, Astro.url);
const resolvedFavicon = resolveInternalUrl(favicon);
// BCP 47 ("en-US") → Open Graph locale ("en_US")
const ogLocale = (config.app.website.language || "").replace("-", "_") || null;

const publishedIso = publishedTime ? new Date(publishedTime).toISOString() : null;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href={resolvedFavicon} />
<link rel="sitemap" href={resolveInternalUrl("/sitemap-index.xml")} />
<link
  rel="alternate"
  type="application/rss+xml"
  title={titleSeo}
  href={new URL("rss.xml", Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

{
  /* vite-plugin-pwa cannot inject these into Astro's static output (no transformIndexHtml
     pass at build), so the tags are emitted here. registerSW.js is generated by the
     integration and registers the worker inside its own `load` listener: no import, no
     workbox-window in the page bundle, nothing on the critical path. Production only: both
     files are generated at build and 404 in dev. */
}
{
  pwa.enabled && import.meta.env.PROD && (
    <Fragment>
      <link rel="manifest" href={pwa.manifestHref} />
      {pwa.themeColor && <meta name="theme-color" content={pwa.themeColor} />}
      {pwa.appleTouchIcon && <link rel="apple-touch-icon" href={pwa.appleTouchIcon} />}
      <script is:inline defer src={pwa.registerHref} />
    </Fragment>
  )
}

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{titleSeo}</title>
<meta name="title" content={titleSeo} />
<meta name="description" content={descriptionSeo} />

{robots && <meta name="robots" content={robots} />}

<!-- Open Graph / Facebook -->
<meta property="og:type" content={publishedIso ? "article" : "website"} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={titleSeo} />
<meta property="og:description" content={descriptionSeo} />
<meta property="og:image" content={ogImageUrl} />
{ogLocale && <meta property="og:locale" content={ogLocale} />}
{publishedIso && <meta property="article:published_time" content={publishedIso} />}

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={titleSeo} />
<meta property="twitter:description" content={descriptionSeo} />
<meta property="twitter:image" content={ogImageUrl} />

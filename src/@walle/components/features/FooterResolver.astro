---
// Resolves the footer variant selected in app.json (`components.footer`), defaulting to "standard".
// Unknown variants are rejected at build time by assertVariants in define-config.ts.
import config from "@walle/config";

const selected = config.app.components?.footer ?? "standard";
// Only the selected variant is imported: a static import of both put the unused
// variant's stylesheet on every page (unknown values already fail the build in
// define-config assertVariants, so the fallback here stays "standard").
const Variant =
  selected === "minimal"
    ? (await import("./Footer.minimal.astro")).default
    : (await import("./Footer.astro")).default;
---

<Variant />

---
import type { JsonLd } from "@walle/utils/structured-data";

/**
 * Renders schema.org JSON-LD. Pass one object or an array; the
 * `@context` is added automatically. Builders for the common shapes
 * (WebSite, Organization, Article, Product) live in
 * `@walle/utils/structured-data`.
 */
export interface Props {
  data: JsonLd | JsonLd[];
}

const { data } = Astro.props;

const payload = Array.isArray(data)
  ? data.map((d) => ({ "@context": "https://schema.org", ...d }))
  : { "@context": "https://schema.org", ...data };

// The payload is JSON (not JS), so the only way an untrusted value (e.g. a product
// name/description from an external source) could break out of the element is a
// literal "</script>". Escaping <, > and & to their JSON unicode escapes neutralizes
// that while keeping the JSON valid.
//
// Plain-string replaceAll, not a /</>/&/g regex: astro-language-server's frontmatter/template
// boundary scanner mis-tokenizes literal `<`/`>` characters inside a regex literal here, which
// breaks `astro check` on this file with cascading "expected `---`" parse errors even though
// both the Go and Rust @astrojs/compiler parse it cleanly (this is the tool's bug, not the code's).
const json = JSON.stringify(payload)
  .replaceAll("<", "\\u003c")
  .replaceAll(">", "\\u003e")
  .replaceAll("&", "\\u0026");
---

<script type="application/ld+json" set:html={json} is:inline />

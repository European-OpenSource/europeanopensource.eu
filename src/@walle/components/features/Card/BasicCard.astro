---
import config from "@walle/config";
import { formatDate, label } from "@walle/utils";
import type { BaseProps, Variant } from "../../shared/types";
import { linkAttrs, splitProps, variantAttrs } from "../../shared/attrs";

export interface Props extends BaseProps {
  title: string;
  /**
   * Excerpt text, truncated to `excerptLength`. Omit and use the default slot instead for
   * richer markup that shouldn't be truncated.
   */
  content?: string;
  /**
   * Max characters kept from `content` before appending "...".
   * @default 120
   */
  excerptLength?: number;
  image?: {
    src: string;
    alt: string;
  };
  href: string;
  target?: "_blank" | "_self";
  class?: string;
  publishDate?: Date | string | null;
  /**
   * Visual variant
   * @default "primary"
   */
  variant?: Variant;
  badge?: {
    text: string;
    variant?: "primary" | "secondary";
  };
}

const OWN_KEYS = [
  "title",
  "content",
  "excerptLength",
  "image",
  "href",
  "target",
  "class",
  "publishDate",
  "variant",
  "badge",
] as const;

const { own, rest } = splitProps(Astro.props, OWN_KEYS);
const {
  title,
  content,
  excerptLength = 120,
  image,
  href,
  target = "_self",
  class: className = "",
  badge,
  publishDate,
  variant = "primary",
} = own;

const cardClasses = ["card", className].filter(Boolean).join(" ");

const formattedDate = publishDate
  ? formatDate(publishDate.toString(), config.app.website.language)
  : null;

const truncatedContent =
  content !== undefined
    ? content.length > excerptLength
      ? content.substring(0, excerptLength) + "..."
      : content
    : undefined;
---

<a
  href={href}
  target={target}
  rel={linkAttrs({ target }).rel}
  class={cardClasses}
  aria-label={label("card.read").replace("{title}", title)}
  {...variantAttrs({ variant })}
  {...rest}
>
  <article class="card__wrapper">
    {
      image && (
        <div class="card__image">
          <img src={image.src} alt={image.alt} loading="lazy" width="120" height="120" />
        </div>
      )
    }

    <div class="card__content">
      <div class="card__meta">
        {
          badge && (
            <span class={`card__badge card__badge--${badge.variant || "primary"}`}>
              {badge.text}
            </span>
          )
        }
        {formattedDate && <span class="card__date">{formattedDate}</span>}
      </div>

      <h3 class="card__title">{title}</h3>
      <div class="card__description">{content !== undefined ? truncatedContent : <slot />}</div>
    </div>
  </article>
</a>

<style>
  @layer walle.components {
    .card {
      /* Public properties */
      --card-bg: var(--surface);
      --card-border: var(--card-bg);
      --card-radius: var(--radius-md);
      --card-padding: 20px;
      --card-shadow: var(--shadow-md);
      --card-shadow-hover: var(--shadow-lg);
      --card-title-color: var(--text);
      --card-title-color-hover: var(--variant-color);

      /* Internal */
      --_card-gap: 12px;
      --_card-transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);

      display: block;
      text-decoration: none;
      color: inherit;
      width: 100%;
      height: 100%;
    }

    .card__wrapper {
      display: flex;
      flex-direction: column;
      height: 100%;
      min-height: 380px;
      padding: var(--card-padding);
      border: 1px solid var(--card-border);
      border-radius: var(--card-radius);
      background: var(--card-bg);
      box-shadow: var(--card-shadow);
      transition:
        transform var(--_card-transition),
        box-shadow var(--_card-transition);
      box-sizing: border-box;
      overflow: hidden;
    }

    .card:hover .card__wrapper {
      transform: translateY(-2px);
      box-shadow: var(--card-shadow-hover);
      border-color: var(--variant-color);
    }

    .card:focus {
      outline: 2px solid var(--focus-ring);
      outline-offset: 2px;
      border-radius: var(--card-radius);
    }

    .card__image {
      /* Full-bleed to the card's top edges: cancel the wrapper padding so the image
               reaches the border, with only the top corners rounded (the wrapper clips
               them) and a square bottom. No inset, no double border. */
      aspect-ratio: 1;
      overflow: hidden;
      background: var(--surface-alt);
      margin: calc(var(--card-padding) * -1) calc(var(--card-padding) * -1) var(--space-lg);
      border-radius: 0;
    }

    .card__image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.3s ease;
    }

    .card:hover .card__image img {
      transform: scale(1.03);
    }

    .card__content {
      display: flex;
      flex-direction: column;
      gap: var(--_card-gap);
      flex: 1;
    }

    .card__meta {
      display: flex;
      align-items: center;
      gap: var(--space-sm);
      flex-wrap: wrap;
      margin-bottom: var(--space-xs);
    }

    .card__badge {
      font-size: 0.6875rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      padding: 4px 10px;
      border-radius: var(--radius-sm);
    }

    .card__badge--primary {
      color: var(--primary);
      background: color-mix(in srgb, var(--primary) 8%, transparent);
    }

    .card__badge--secondary {
      color: var(--secondary);
      background: color-mix(in srgb, var(--secondary) 8%, transparent);
    }

    .card__date {
      font-size: var(--font-size-xs);
      font-weight: 500;
      color: var(--text-muted);
      letter-spacing: 0.3px;
    }

    .card__title {
      font-size: var(--font-size-body);
      font-weight: 700;
      line-height: 1.3;
      color: var(--card-title-color);
      margin: 0 0 var(--space-sm) 0;
      transition: color 0.2s ease;
    }

    .card:hover .card__title {
      color: var(--card-title-color-hover);
    }

    .card__description {
      font-size: var(--font-size-sm);
      line-height: 1.5;
      color: var(--text-muted);
      margin: 0;
      flex: 1;
    }

    /* Responsive adjustments */
    @media (max-width: 640px) {
      .card {
        --card-padding: 16px;
        --_card-gap: 10px;
      }

      .card__wrapper {
        min-height: 340px;
      }

      .card__title {
        font-size: 1rem;
      }

      .card__description {
        font-size: 0.8125rem;
        line-height: 1.5;
      }

      .card__badge {
        font-size: 0.625rem;
        padding: 3px 8px;
      }

      .card__date {
        font-size: 0.6875rem;
      }

      .card__image {
        margin-bottom: var(--space-md);
      }
    }

    @media (min-width: 641px) and (max-width: 768px) {
      .card {
        --card-padding: 18px;
        --_card-gap: 11px;
      }

      .card__wrapper {
        min-height: 360px;
      }

      .card__title {
        font-size: 1.0625rem;
      }

      .card__description {
        font-size: 0.8125rem;
      }
    }

    @media (min-width: 769px) {
      .card__wrapper {
        min-height: 380px;
      }
    }

    /* Accessibility */
    @media (prefers-reduced-motion: reduce) {
      .card,
      .card__wrapper,
      .card__image img,
      .card__title {
        transition: none;
      }

      .card:hover .card__image img {
        transform: none;
      }
    }

    @media (prefers-contrast: high) {
      .card__wrapper {
        border: 2px solid var(--black);
      }

      .card:hover .card__wrapper {
        border-color: var(--primary-dark);
      }

      .card__badge--primary {
        background: var(--primary);
        color: var(--white);
      }

      .card__badge--secondary {
        background: var(--secondary);
        color: var(--white);
      }
    }

    /* Focus visible for keyboard navigation */
    .card:focus-visible {
      outline: 2px solid var(--focus-ring);
      outline-offset: 2px;
    }
  }
</style>

---
import Footer from "@walle/components/features/FooterResolver.astro";
import Navbar from "@walle/components/features/Navbar/NavbarResolver.astro";
import config from "@walle/config";
import type { NavbarConfig } from "@walle/config";
import AbstractLayout from "./AbstractLayout.astro";

import { getCollection } from "astro:content";

// Cart UI only in commerce mode; a vetrina site ships none of it. `cartInNavbar` puts
// the trigger in the navbar, otherwise it floats bottom-right.
const commerce = (config.app as { commerce?: { showBuyButton?: boolean; cartInNavbar?: boolean } })
  .commerce;
const showCart = commerce?.showBuyButton ?? false;
// Imported dynamically so a vetrina site keeps the cart out of its module graph entirely.
// Astro collects a page's CSS from that graph, not from what renders, so a static import
// shipped the whole cart stylesheet on every page of every site that never shows a cart.
const CartMount = showCart ? (await import("@walle/commerce/CartMount.astro")).default : null;
const CartBadge = showCart ? (await import("@walle/commerce/CartBadge.astro")).default : null;
const cartInNavbar = commerce?.cartInNavbar ?? false;

// "Docs" link for the showcase's /wiki pages (seed-excluded, so consumers never have them).
// Checked before getCollection(): on a missing collection Astro logs a warning on every request.
let navbarConfig: NavbarConfig = config.navbar || {};
if (Object.keys(import.meta.glob("/src/pages/wiki/index.astro")).length > 0) {
  const wikiPages = await getCollection("wiki");
  if (wikiPages.length > 0) {
    navbarConfig = {
      ...navbarConfig,
      items: [...(navbarConfig.items ?? []), { name: "Docs", url: "/wiki" }],
    };
  }
}
---

<AbstractLayout {...Astro.props}>
  <slot name="head" slot="head" />
  <slot name="navbar">
    <Navbar config={navbarConfig}>
      {showCart && CartBadge && <CartBadge slot="actions" floating={false} />}
    </Navbar>
  </slot>
  <main id="main-content" tabindex="-1">
    <slot />
  </main>
  <slot name="footer">
    <Footer />
  </slot>
  {showCart && CartMount && <CartMount />}
  {showCart && !cartInNavbar && CartBadge && <CartBadge floating={true} />}
</AbstractLayout>

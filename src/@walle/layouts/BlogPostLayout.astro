---
import BlogReadingProgress from "@walle/components/features/Blog/BlogReadingProgress.astro";
import {
  toc as BlogTableOfContents,
  pageHeader as SectionHeaderStandard,
} from "virtual:walle-components";
import StructuredData from "@walle/components/features/StructuredData.astro";
import BaseLayout from "./BaseLayout.astro";
import config from "@walle/config";
import { ogImageUrl } from "@walle/og";
import { formatDate, label } from "@walle/utils";
import { articleJsonLd } from "@walle/utils/structured-data";

export type { BlogPostLayoutProps as Props } from "./types";

const {
  title,
  description,
  author,
  publishDate,
  readingTime,
  tags,
  image = null,
  draft = false,
  id,
} = Astro.props;

// This post's generated OG image exists only when the feature is on and `posts` is one of its
// collections; otherwise `ogImageUrl` would point at a route that doesn't exist. A post's own
// `image` is passed as the explicit OG image below, so it always wins over the generated one.
const ogImage = config.app.seo?.ogImage;
const entryOgImage =
  id && ogImage?.enabled && ogImage.collections?.includes("posts")
    ? ogImageUrl("posts", id)
    : undefined;
---

<BaseLayout
  headerTitle={title}
  headerDescription={description}
  headerImage={image}
  headerOgImage={image}
  headerEntryOgImage={entryOgImage}
  headerPublishedTime={publishDate}
>
  <slot name="head" slot="head" />
  {
    !draft && (
      <StructuredData
        data={articleJsonLd({
          title,
          description,
          url: Astro.url.href,
          publishDate,
          author,
          image: image ? new URL(image, Astro.site).href : undefined,
          tags,
        })}
      />
    )
  }
  <slot name="before" />
  {
    draft ? (
      <div class="draft-message" role="status" aria-live="polite">
        <h1>{label("notFound.title")}</h1>
        <p>{label("notFound.message")}</p>
      </div>
    ) : (
      <>
        <SectionHeaderStandard title={title} subtitle={description} muted>
          <div class="meta-wrapper">
            {(author || publishDate || readingTime) && (
              <ul class="meta-info no-markers" aria-label={label("blog.info")}>
                {author && (
                  <li class="meta-author">
                    <span class="sr-only">Author: </span>
                    {author}
                  </li>
                )}
                {publishDate && (
                  <li>
                    <time
                      class="meta-date"
                      datetime={publishDate.toISOString()}
                      aria-label={label("blog.publishedOn").replace(
                        "{date}",
                        formatDate(publishDate.toString()) ?? ""
                      )}
                    >
                      {formatDate(publishDate.toString())}
                    </time>
                  </li>
                )}
                {readingTime && <li class="meta-reading">{readingTime}</li>}
              </ul>
            )}
            {tags && tags.length > 0 && (
              <ul class="tags no-markers" aria-label={label("blog.tags")}>
                {tags.map((tag: string) => (
                  <li>
                    <span class="tag">{tag}</span>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </SectionHeaderStandard>

        <BlogReadingProgress />
        <div class="article-container">
          <BlogTableOfContents />

          <article class="article" aria-label={title}>
            <div class="prose" id="article-content">
              <slot />
            </div>
          </article>
        </div>
      </>
    )
  }
  <slot name="after" />
</BaseLayout>

<style>
  @layer walle.components {
    /* Draft Message */
    .draft-message {
      text-align: center;
      padding: 64px 0;
      color: var(--text-muted);
      font-size: var(--font-size-body);
    }

    /* Article Container Layout */
    .article-container {
      max-width: 1200px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 280px 1fr;
      gap: 3rem;
      padding: 0 2rem;
      align-items: start;
      box-sizing: border-box;
      width: 100%;
    }

    /* Article Styles */
    .article {
      background: var(--surface);
      position: relative;
      min-height: 100vh;
    }

    /* Meta Information */
    .meta-wrapper {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
      margin-bottom: 2rem;
    }

    .meta-info {
      display: flex;
      justify-content: center;
      gap: 1rem;
      font-size: 0.875rem;
      /* Inherits the header's own foreground (SectionWrapper's --wrapper-fg): a fixed
                     muted-gray here loses contrast once the header is filled with a variant color. */
      color: inherit;
      flex-wrap: wrap;
      list-style: none;
      padding: 0;
      margin: 0;
    }

    .meta-author,
    .meta-date,
    .meta-reading {
      position: relative;
      font-weight: 500;
      letter-spacing: 0.025em;
    }

    .meta-author::after,
    .meta-date::after {
      content: "•";
      margin-left: 1rem;
      opacity: 0.5;
    }

    /* Tags */
    .tags {
      display: flex;
      justify-content: center;
      gap: 0.5rem;
      flex-wrap: wrap;
      list-style: none;
      padding: 0;
      margin: 0;
    }

    .tag {
      /* Public property */
      --blog-tag-radius: var(--radius-xl);

      background: var(--secondary);
      color: var(--white);
      padding: 0.25rem 0.75rem;
      border-radius: var(--blog-tag-radius);
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      transition: all var(--transition);
      border: 1px solid transparent;
    }

    .tag:hover {
      background: var(--secondary-light);
      color: var(--white);
      transform: translateY(-1px);
    }

    /* Responsive - Tablet */
    @media (max-width: 1024px) {
      .article-container {
        grid-template-columns: 1fr;
        gap: 2rem;
        padding: 0 1.5rem;
      }
    }

    /* Responsive - Mobile */
    @media (max-width: 768px) {
      .draft-message {
        padding: 2rem 1.5rem;
        border-radius: var(--radius-xl);
      }

      .draft-message h1 {
        font-size: 2rem;
      }

      .draft-message p {
        font-size: 1rem;
      }

      .article-container {
        padding: 0 1rem;
        gap: 1.5rem;
      }

      .meta-info {
        flex-direction: column;
        gap: 0.5rem;
        align-items: center;
      }

      .meta-author::after,
      .meta-date::after {
        display: none;
      }
    }

    /* Responsive - Small Mobile */
    @media (max-width: 480px) {
      .draft-container {
        padding: 1.5rem 0.75rem;
      }

      .draft-message {
        padding: 1.5rem 1rem;
        border-radius: var(--radius-xl);
      }

      .draft-message h1 {
        font-size: 1.75rem;
      }

      .draft-message p {
        font-size: 0.9rem;
      }

      .article-container {
        padding: 0 0.75rem;
        gap: 1rem;
        max-width: 100vw;
        overflow-x: hidden;
        margin: 0;
      }

      .tags {
        gap: 0.25rem;
      }

      .tag {
        font-size: 0.625rem;
        padding: 0.25rem 0.5rem;
      }
    }

    /* Responsive - Extra Small Mobile */
    @media (max-width: 375px) {
      .article-container {
        padding: 0 0.5rem;
        margin: 0;
        max-width: 100vw;
      }
    }

    /* Print Styles */
    @media print {
      .article-container {
        grid-template-columns: 1fr;
        max-width: none;
        padding: 0;
      }
    }
  }
</style>
